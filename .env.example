# --- MongoDB ---
# Atlas: mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Локально: mongodb://127.0.0.1:27017
# Если не задать — проект работает на данных в памяти (демо-режим)
MONGODB_URI=
MONGODB_DB=karosa

# --- Админка ---
# Пароль. Без него /admin недоступна
ADMIN_PASSWORD=
# Секрет для подписи cookie сессии. По умолчанию берётся ADMIN_PASSWORD,
# но лучше задать отдельный: тогда смена пароля не разлогинит всех разом
ADMIN_SECRET=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Только для супергрупп с темами
TELEGRAM_THREAD_ID=
# Ключ для /api/telegram/test в проде
TELEGRAM_TEST_KEY=

# Куда слать заявки: telegram,email,whatsapp,sms (через запятую)
NOTIFY_CHANNELS=telegram

# Публичный адрес сайта (для SEO / sitemap)
NEXT_PUBLIC_SITE_URL=https://example.com
